# ── PG DB: MySQL + mysqld_exporter ──
set +x
ROOT_PW=$(secret pg-db/root-password)
APP_PW=$(secret pg-db/app-password)
EXPORTER_PW=$(secret exporter-password)

# 최초 기동 시 1번만 실행되는 초기화 SQL: exporter 읽기 전용 계정
mkdir -p /opt/mysql-init
cat > /opt/mysql-init/01-exporter.sql <<SQL
CREATE USER IF NOT EXISTS 'exporter'@'%' IDENTIFIED BY '$EXPORTER_PW' WITH MAX_USER_CONNECTIONS 3;
GRANT PROCESS, REPLICATION CLIENT, SELECT ON *.* TO 'exporter'@'%';
SQL
# MySQL 컨테이너는 초기화 SQL을 root가 아니라 mysql 사용자(uid 999)로 실행한다
# → 소유자를 999로 바꿔 읽을 수 있게 하고, 비밀번호가 들어 있으므로 권한은 600(소유자만)을 유지
chown 999:999 /opt/mysql-init/01-exporter.sql
chmod 600 /opt/mysql-init/01-exporter.sql

# 헬스 체크: 127.0.0.1(TCP)로 ping → 초기화 중 임시 서버(네트워크 꺼짐)가 아니라 실제 서버가 떴을 때만 healthy
docker run -d --name mysql --network host --restart unless-stopped \
  -e MYSQL_ROOT_PASSWORD="$ROOT_PW" \
  -e MYSQL_DATABASE=pg -e MYSQL_USER=pg -e MYSQL_PASSWORD="$APP_PW" \
  -e TZ=Asia/Seoul \
  --health-cmd 'mysqladmin ping -h 127.0.0.1 -uroot -p"$MYSQL_ROOT_PASSWORD" --silent' \
  --health-interval 5s --health-timeout 3s --health-retries 3 --health-start-period 30s \
  -v mysql-data:/var/lib/mysql \
  -v /opt/mysql-init:/docker-entrypoint-initdb.d:ro \
  mysql:8.0 \
  --character-set-server=utf8mb4 --collation-server=utf8mb4_unicode_ci \
  --slow_query_log=ON --long_query_time=0.2

docker run -d --name mysqld-exporter --network host --restart unless-stopped \
  -e MYSQLD_EXPORTER_PASSWORD="$EXPORTER_PW" \
  prom/mysqld-exporter:v0.16.0 \
  --mysqld.address=127.0.0.1:3306 --mysqld.username=exporter \
  --collect.info_schema.innodb_metrics \
  --collect.perf_schema.eventsstatements \
  --collect.perf_schema.tableiowaits
set -x
